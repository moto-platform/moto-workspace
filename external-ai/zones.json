    {"repo": "moto-workspace", "glob": "STATUS.md", "zone": "yellow", "why": "session handoff; keep its format (<= 60 lines, sections unchanged)"},
    {"repo": "moto-workspace", "glob": "ISSUES.md", "zone": "yellow", "why": "issue table; add rows, do not close Claude's"},
    {"repo": "moto-workspace", "glob": "*", "zone": "yellow", "why": "workspace files"},

    {"repo": "moto-vehicle-defs", "glob": "docs/ideas/*", "zone": "green", "why": "idea notes, not decisions"},
    {"repo": "moto-vehicle-defs", "glob": "docs/DECISIONS.md", "zone": "red", "why": "decision record; new decisions need the user and Claude"},
    {"repo": "moto-vehicle-defs", "glob": "docs/ARCHITECTURE.md", "zone": "red", "why": "authoritative architecture summary"},
    {"repo": "moto-vehicle-defs", "glob": "docs/*", "zone": "yellow", "why": "platform docs; facts must match DECISIONS.md"},
