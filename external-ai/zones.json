{
  "_comment": "Edit zones for non-Claude AI tools (D-071). Rules are checked in order; the first whose repo and glob match a changed path wins. Globs use fnmatch on repo-relative POSIX paths ('*' also matches '/'). red = Claude only: do not edit, log a request instead. yellow = may edit, the PR needs a Claude review before the user merges. green = free; still log it. scripts/check_zones.py reads this file; scripts/sync_claude.py renders it into AGENTS.md.",
  "zones": {
    "red": "Claude only. Do not edit. Write the request into your log entry (section 'For Claude') and stop.",
    "yellow": "Allowed. Open the PR with the 'needs-claude-review' note; Claude runs the listed reviews before the user merges.",
    "green": "Allowed. Log it; Claude may look at it later."
  },
  "rules": [
    {"repo": "*", "glob": ".claude/*", "zone": "red", "why": "Claude agents, skills and synced rules; edited only in moto-workspace by Claude"},
    {"repo": "*", "glob": "AGENTS.md", "zone": "red", "why": "generated from moto-workspace by scripts/sync_claude.py"},
    {"repo": "*", "glob": "GEMINI.md", "zone": "red", "why": "generated from moto-workspace by scripts/sync_claude.py"},
    {"repo": "*", "glob": "CLAUDE.md", "zone": "red", "why": "Claude Code instructions"},
    {"repo": "*", "glob": ".github/*", "zone": "red", "why": "CI gates (D-046, D-049) protect every contributor; weakening them hides mistakes"},
    {"repo": "*", "glob": "external/moto-vehicle-defs", "zone": "red", "why": "defs submodule pin: version bumps follow releases and manifest.yaml (D-036)"},
    {"repo": "*", "glob": "external/*", "zone": "red", "why": "submodules and vendored code"},
    {"repo": "*", "glob": "gen/*", "zone": "red", "why": "generated code: change the source in moto-vehicle-defs, never gen/ (invariant 2)"},
    {"repo": "*", "glob": "*/gen/*", "zone": "red", "why": "generated code: change the source in moto-vehicle-defs, never gen/ (invariant 2)"},
    {"repo": "*", "glob": "misra/*", "zone": "red", "why": "MISRA deviation register (D-046)"},

    {"repo": "moto-workspace", "glob": "external-ai/log/TEMPLATE.md", "zone": "red", "why": "copy it, do not edit it"},
    {"repo": "moto-workspace", "glob": "external-ai/log/*", "zone": "green", "why": "your session log"},
    {"repo": "moto-workspace", "glob": "external-ai/*", "zone": "red", "why": "zones and rules for external tools"},
    {"repo": "moto-workspace", "glob": "PLATFORM-RULES.md", "zone": "red", "why": "platform invariants"},
    {"repo": "moto-workspace", "glob": "manifest.yaml", "zone": "red", "why": "known-good version set (D-036)"},
    {"repo": "moto-workspace", "glob": "scripts/*", "zone": "red", "why": "sync, worktree and zone tooling"},
